# Deepgram — text to speech for the guest voice (both screens)
DEEPGRAM_API_KEY=
# Optional. Deepgram Aura voice for the two English screens. Defaults to aura-2-thalia-en.
DEEPGRAM_TTS_MODEL=

# Which scoring provider /api/score uses by default: qwen | gemini
SCORING_PROVIDER=

# Qwen — Alibaba Cloud Model Studio, international endpoint
DASHSCOPE_API_KEY=
# Optional. Defaults to qwen3-omni-flash.
QWEN_MODEL=
# Optional. Defaults to https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_BASE_URL=

# Gemini — Google AI Studio
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.6-flash.
GEMINI_MODEL=

# Optional. French Aura-2 voice for /roleplay-live. Only aura-2-agathe-fr and
# aura-2-hector-fr are available; defaults to aura-2-agathe-fr.
DEEPGRAM_TTS_MODEL_FR=

# Optional. Override the model used by /roleplay-live only, per provider.
QWEN_LIVE_MODEL=
GEMINI_LIVE_MODEL=
